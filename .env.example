# NutriPlay Environment Configuration Template
# Copy this file to .env.local and fill in the values

# Weather API configuration (OpenWeatherMap API or compatible provider)
# Server-side abstraction only - NEVER exposed to frontend
WEATHER_API_KEY=
WEATHER_API_BASE_URL=https://api.openweathermap.org/data/2.5

# Required for account sessions. Generate a unique random value of at least 32 bytes.
# Example: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
NUTRIPLAY_SESSION_SECRET=

# Optional persistent data directory; must be writable and retained across deployments.
# Defaults to .nutriplay-data in the project root.
NUTRIPLAY_DATA_DIR=

# Optional Application settings
NEXT_PUBLIC_APP_NAME="NutriPlay — Indian Sports Nutrition Decision-Support System"
NEXT_PUBLIC_APP_VERSION="1.0.0-dev"
